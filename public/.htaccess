# Hostinger (Apache) config for the APAS single-page app.
DirectoryIndex index.html

# Apache does not know .mjs and serves it as text/plain; browsers then refuse to load it as a module
# (the PDF preview's pdf.worker.min-*.mjs failed with "Failed to fetch dynamically imported module").
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve real files and folders as-is; send every other path to the React app.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html must never be cached, so browsers always pick up the new asset file names after a deploy
  # (a cached index.html is what causes "Unable to preload CSS for /assets/...").
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Hashed asset files never change, so they can be cached for a long time.
  <FilesMatch "\.(m?js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
