                          <Button
                            variant="ghost"
                            size="icon"
                            className="h-7 w-7"
                            onClick={() => openEditFee(f)}
                          >
                            <Pencil className="h-3.5 w-3.5 text-slate-500" />
                          </Button>
                          <Button
                            variant="ghost"
                            size="icon"
                            className="h-7 w-7"
                            onClick={() => setDeleteTarget(f)}
                          >
                            <Trash2 className="h-3.5 w-3.5 text-red-500" />
                          </Button>
                        </div>
                      </div>
                      <div className="grid grid-cols-3 gap-x-3 gap-y-1 text-xs text-slate-500 border-t border-slate-100 pt-2">
                        <span>Course â‚¹{(f.course_amount ?? 0).toLocaleString()}</span>
                        <span>Transport â‚¹{(f.transport_amount ?? 0).toLocaleString()}</span>
                        <span>Uniform â‚¹{(f.uniform_amount ?? 0).toLocaleString()}</span>
                        <span>Material â‚¹{(f.material_amount ?? 0).toLocaleString()}</span>
                        <span>Exam â‚¹{(f.exam_amount ?? 0).toLocaleString()}</span>
                        <span>Other â‚¹{(f.other_amount ?? 0).toLocaleString()}</span>
                      </div>
                    </div>
                  ))
                )}
              </div>

              <DialogFooter className="mt-4">
                <Button variant="outline" onClick={() => setDetailsStudentId(null)}>
                  Close
                </Button>
              </DialogFooter>
            </>
          )}
        </DialogContent>
      </Dialog>
      <ERPFeeAssistantWidget schoolId={schoolId} onNavigate={(tab) => setActiveTab(tab as "records" | "history")} isFeesTab />
    </ERPLayout>
  );
};

export default ERPFeeManagement;

